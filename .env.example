NODE_ENV=production
PORT=5000
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
BCRYPT_SALT_ROUNDS=10
JWT_SECKRET_TOKEN=replace_with_long_random_secret
JWT_EXPIRE_IN=1d
JWT_REFRESH_TOKEN=replace_with_long_random_refresh_secret
JWT_REFRESH_EXPIRE_IN=30d
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_URL=https://your-frontend-domain.vercel.app
